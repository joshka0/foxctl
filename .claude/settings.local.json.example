{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copy this to settings.local.json for local overrides (gitignored)",
  "permissions": {
    "allow": [
      "Edit:*",
      "Write:*",
      "MultiEdit:*",
      "NotebookEdit:*",
      "Bash:*"
    ],
    "defaultMode": "acceptEdits"
  },
  "env": {
    "FOXCTL_TASK_GUARD_MODE": "auto"
  }
}
