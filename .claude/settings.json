{
  "permissions": {
    "allow": [
      "Read:*",
      "Bash(make):*",
      "Bash(go):*",
      "Bash(git):*"
    ],
    "defaultMode": "askEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/task-guard.sh"
          }
        ]
      }
    ]
  }
}
