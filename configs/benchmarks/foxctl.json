{
  "version": 1,
  "suite": "foxctl-benchmark-suite",
  "description": "Canonical benchmark and eval inventory for foxctl's Go runtime, repoindex/DAG retrieval, RLM, room runtime, hooks, and integrations.",
  "categories": [
    {
      "id": "runtime",
      "name": "Runtime",
      "status": "implemented",
      "owner": "bench-runtime",
      "description": "Go microbenchmarks for execution, lifecycle, scheduler, and tool-runner overhead."
    },
    {
      "id": "repoindex",
      "name": "Repoindex",
      "status": "implemented",
      "owner": "bench-repoindex",
      "description": "FTS and graph-navigation benchmarks over deterministic repoindex fixtures."
    },
    {
      "id": "dag",
      "name": "DAG",
      "status": "implemented",
      "owner": "bench-dag",
      "description": "Explanation-subgraph benchmarks for DAG grep and structural edge expansion."
    },
    {
      "id": "retrieval",
      "name": "Retrieval",
      "status": "implemented",
      "owner": "bench-retrieval",
      "description": "Fixture-backed retrieval eval suites and policy checks."
    },
    {
      "id": "rlm",
      "name": "RLM",
      "status": "implemented",
      "owner": "bench-rlm",
      "description": "Model-free RLM planner/tool-policy benchmarks plus extended gather-context and LongCoT evidence suites."
    },
    {
      "id": "room",
      "name": "Room Runtime",
      "status": "implemented",
      "owner": "bench-room",
      "description": "Room-agile frontier, story validation, and dispatch behavior checks."
    },
    {
      "id": "integrations",
      "name": "Integrations and Hooks",
      "status": "implemented",
      "owner": "bench-integrations",
      "description": "Hook latency and structured-shell integration overhead lanes."
    }
  ],
  "benchmarks": [
    {
      "id": "runtime.exec-buffer-pool",
      "category": "runtime",
      "status": "implemented",
      "runner": "go-test-bench",
      "default_gate": true,
      "extended_gate": false,
      "requires_network": false,
      "requires_llm": false,
      "commands": [
        "BENCH_PATTERN=BenchmarkBufferPooling ./scripts/run-go-benchmarks.sh ./internal/runtime/execution/exec"
      ],
      "packages": [
        "./internal/runtime/execution/exec"
      ],
      "fixtures": [
        "synthetic execution payload"
      ],
      "metrics": [
        "ns/op",
        "B/op",
        "allocs/op"
      ],
      "artifacts": [
        "BENCH_OUT text file"
      ],
      "notes": "Existing exec buffer-pool benchmark; retained as the lowest-level runtime allocation sentinel."
