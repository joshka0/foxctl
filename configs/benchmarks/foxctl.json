    {
      "id": "rlm.provider-agent-baseline",
      "category": "rlm",
      "status": "experimental",
      "runner": "foxctl-eval",
      "default_gate": false,
      "extended_gate": true,
      "requires_network": true,
      "requires_llm": true,
      "commands": [
        "./bin/foxctl eval agents --eval-dataset-file testdata/evals/gather-context/foxctl-repo-grounded.jsonl --case-limit 2 --role researcher --target openrouter:openai/gpt-5.4-mini --input-token-price-per-million-usd 1 --output-token-price-per-million-usd 1 --report-file /private/tmp/foxctl-benchmarks/provider-agent.json",
        "jq -c '.results[]' /private/tmp/foxctl-benchmarks/provider-agent.json > /private/tmp/foxctl-benchmarks/provider-agent-results.jsonl",
        "./bin/foxctl eval gather-context --eval-dataset-file testdata/evals/gather-context/foxctl-repo-grounded.jsonl --case-limit 2 --agent-baseline-results /private/tmp/foxctl-benchmarks/provider-agent-results.jsonl --baseline-input-token-price-per-million-usd 1 --baseline-output-token-price-per-million-usd 1 --report-file /private/tmp/foxctl-benchmarks/gather-context-head-to-head.json"
      ],
      "fixtures": [
        "testdata/evals/gather-context/foxctl-repo-grounded.jsonl",
        "authenticated OpenRouter-backed foxctl eval-agent target"
      ],
      "metrics": [
        "baseline_pass_rate",
        "baseline_error_count",
        "baseline_mean_path_recall",
        "baseline_mean_fact_recall",
        "baseline_mean_duration_ms",
        "baseline_mean_tokens",
        "baseline_mean_cost_usd",
        "duration_speedup",
        "path_recall_delta",
        "fact_recall_delta"
      ],
      "artifacts": [
        "provider-backed eval agents report JSON",
        "provider-backed external-results JSONL",
        "gather-context head-to-head report JSON"
      ],
      "notes": "This is the provider-backed foxctl eval-agent comparison lane, not a local Codex native subagent baseline. It is intentionally extended-only because it needs model credentials; unauthenticated failures should be recorded as baseline_error_count, not treated as performance numbers. The default command uses normalized $1/Mtok input and output prices so cost deltas are explicit even when provider/model pricing is unavailable."
    },
