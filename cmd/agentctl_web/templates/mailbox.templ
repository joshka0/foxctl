package templates

templ Mailbox(messages []MailboxMessage, actorID string, workspace string, workspaces []Workspace) {
	@Layout("Mailbox", "/mailbox", workspace, workspaces) {
		<div class="page-header">
			<h1 class="page-title">Mailbox</h1>
			<div>
				<input 
					type="text" 
					name="actor" 
					placeholder="Actor ID (e.g., actor:coder:agent1)"
					value={ actorID }
					class="select"
					style="width: 300px;"
					hx-get="/mailbox" 
					hx-target="#mailbox-content" 
					hx-trigger="change, keyup delay:500ms"
				/>
			</div>
		</div>
		<div id="mailbox-content">
			@MailboxTable(messages)
		</div>
	}
}

templ MailboxTable(messages []MailboxMessage) {
	if len(messages) == 0 {
		<div class="empty-state">
			<p>No messages</p>
			<p class="text-muted">Enter an actor ID to view their mailbox</p>
		</div>
	} else {
		<div class="card" style="padding: 0; overflow: hidden;">
			<table class="table">
				<thead>
					<tr>
						<th>Status</th>
						<th>Subject</th>
						<th>Sender</th>
						<th>Kind</th>
						<th>Priority</th>
						<th>Created</th>
					</tr>
				</thead>
				<tbody>
					for _, msg := range messages {
						<tr>
							<td>
								@MessageStatus(msg.Status)
							</td>
							<td>{ msg.Subject }</td>
							<td class="mono text-muted">{ msg.Sender }</td>
							<td>
								<span class="chip chip-default">{ msg.Kind }</span>
							</td>
							<td>
								@PriorityChip(msg.Priority)
							</td>
							<td class="text-muted">{ formatTime(msg.CreatedAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ MessageStatus(status string) {
	switch status {
		case "unread":
			<span class="chip chip-info">● Unread</span>
		case "read":
			<span class="chip chip-default">○ Read</span>
		case "archived":
			<span class="chip chip-default">📁 Archived</span>
		default:
			<span class="chip chip-default">{ status }</span>
	}
}

templ PriorityChip(priority int) {
	switch {
		case priority >= 8:
			<span class="chip chip-error">🔴 Critical</span>
		case priority >= 5:
			<span class="chip chip-warning">🟡 High</span>
		case priority >= 3:
			<span class="chip chip-info">🔵 Normal</span>
		default:
			<span class="chip chip-default">⚪ Low</span>
	}
}
