package templates

import "fmt"

templ SQLiteBrowser(databases []SQLiteDatabase) {
	@Layout("SQLite", "/sqlite") {
		<div class="page-header">
			<h1 class="page-title">SQLite Browser</h1>
			<span class="text-muted">Databases in ~/.agentctl</span>
		</div>
		<div id="sqlite-content">
			@SQLiteDatabaseList(databases)
		</div>
	}
}

templ SQLiteDatabaseList(databases []SQLiteDatabase) {
	if len(databases) == 0 {
		<div class="empty-state">
			<p>No databases found</p>
			<p class="text-muted">SQLite databases used by agentctl will appear here</p>
		</div>
	} else {
		<div class="grid-3">
			for _, db := range databases {
				<a 
					href={ templ.SafeURL("/sqlite/" + db.Name) }
					class="card" 
					style="text-decoration: none; display: block; transition: transform 0.15s ease, border-color 0.15s ease;"
					hx-boost="true"
					onmouseover="this.style.borderColor='var(--accent)'; this.style.transform='translateY(-2px)';"
					onmouseout="this.style.borderColor='var(--border)'; this.style.transform='translateY(0)';"
				>
					<div style="display: flex; align-items: center; gap: 1rem;">
						<span style="font-size: 2rem;">🗄️</span>
						<div style="flex: 1;">
							<div style="font-weight: 600; color: var(--text-primary);">{ db.FriendlyName }</div>
							<div class="mono text-muted" style="font-size: 0.75rem;">{ db.Name }.db</div>
						</div>
						<div class="text-muted" style="font-size: 0.875rem;">{ formatSizeBytes(db.Size) }</div>
					</div>
				</a>
			}
		</div>
	}
}

templ SQLiteTables(tables []SQLiteTable, dbName string) {
	@Layout("SQLite - " + dbName, "/sqlite") {
		<div class="breadcrumb">
			<a href="/sqlite" hx-boost="true">SQLite</a>
			<span>/</span>
			<span>{ dbName }</span>
		</div>
		
		<div class="page-header">
			<h1 class="page-title">{ dbName }</h1>
			<span class="text-muted">{ fmt.Sprintf("%d tables", len(tables)) }</span>
		</div>
		
		@SQLiteTableList(tables, dbName)
	}
}

templ SQLiteTableList(tables []SQLiteTable, dbName string) {
	if len(tables) == 0 {
		<div class="empty-state">
			<p>No tables found</p>
			<p class="text-muted">This database appears to be empty</p>
		</div>
	} else {
		<div class="card" style="padding: 0; overflow: hidden;">
			<table class="table">
				<thead>
					<tr>
						<th>Table</th>
						<th>Row Count</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, t := range tables {
						<tr 
							hx-get={ "/sqlite/" + dbName + "/" + t.Name } 
							hx-target=".main" 
							hx-push-url="true"
						>
							<td class="mono">{ t.Name }</td>
							<td>
								<span class="chip chip-default">{ formatRowCountNum(t.RowCount) } rows</span>
							</td>
							<td class="text-muted">→</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ SQLiteData(columns []string, rows []map[string]any, dbName, tableName string, rowCount int) {
	@Layout("SQLite - " + tableName, "/sqlite") {
		<div class="breadcrumb">
			<a href="/sqlite" hx-boost="true">SQLite</a>
			<span>/</span>
			<a href={ templ.SafeURL("/sqlite/" + dbName) } hx-boost="true">{ dbName }</a>
			<span>/</span>
			<span>{ tableName }</span>
		</div>
		
		<div class="page-header">
			<h1 class="page-title">{ tableName }</h1>
			<span class="text-muted">{ fmt.Sprintf("%d rows", rowCount) }</span>
		</div>
		
		@SQLiteDataTable(columns, rows, dbName, tableName)
	}
}

templ SQLiteDataTable(columns []string, rows []map[string]any, dbName, tableName string) {
	if len(rows) == 0 {
		<div class="empty-state">
			<p>No data in table</p>
		</div>
	} else {
		<div class="card" style="padding: 0; overflow-x: auto;">
			<table class="table">
				<thead>
					<tr>
						for _, col := range columns {
							<th>{ col }</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr style="cursor: default;">
							for _, col := range columns {
								<td class="mono" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
									{ formatCellVal(row[col]) }
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(rows) >= 100 {
			<p class="text-muted" style="margin-top: 1rem; text-align: center;">
				Showing first 100 rows
			</p>
		}
	}
}

func formatSizeBytes(bytes int64) string {
	const unit = 1024
	if bytes < unit {
		return fmt.Sprintf("%d B", bytes)
	}
	div, exp := int64(unit), 0
	for n := bytes / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %cB", float64(bytes)/float64(div), "KMGTPE"[exp])
}

func formatRowCountNum(count int) string {
	if count >= 1000000 {
		return fmt.Sprintf("%.1fM", float64(count)/1000000)
	}
	if count >= 1000 {
		return fmt.Sprintf("%.1fK", float64(count)/1000)
	}
	return fmt.Sprintf("%d", count)
}

func formatCellVal(v any) string {
	if v == nil {
		return "NULL"
	}
	switch val := v.(type) {
	case []byte:
		s := string(val)
		if len(s) > 100 {
			return s[:100] + "..."
		}
		return s
	case string:
		if len(val) > 100 {
			return val[:100] + "..."
		}
		return val
	default:
		s := fmt.Sprintf("%v", v)
		if len(s) > 100 {
			return s[:100] + "..."
		}
		return s
	}
}
