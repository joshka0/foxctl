package templates

import "fmt"

templ Search(results []SearchResult, stats *SearchStats, query string, rerank bool, scopes []string, workspace string, workspaces []Workspace) {
	@Layout("Search", "/search", workspace, workspaces) {
		@SearchContent(results, stats, query, rerank, scopes)
	}
}

templ SearchContent(results []SearchResult, stats *SearchStats, query string, rerank bool, scopes []string) {
	<div class="page-header">
		<h1 class="page-title">Semantic Search</h1>
		if stats != nil && stats.Reranked {
			<span class="chip chip-success" style="margin-left: 0.5rem;">Reranked</span>
		}
	</div>

	<!-- Search Form -->
	<div class="card mb-4">
		<form
			hx-get="/search"
			hx-target=".main"
			hx-swap="innerHTML"
			hx-indicator="#search-spinner"
		>
			<div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
				<div style="flex: 1; min-width: 300px;">
					<label class="text-muted" style="font-size: 0.75rem;">Query</label>
					<input
						type="text"
						name="q"
						value={ query }
						placeholder="Search symbols, sessions, memories, tasks..."
						class="input"
						style="width: 100%;"
					/>
				</div>

				<div>
					<label class="text-muted" style="font-size: 0.75rem;">Scopes</label>
					<select name="scope" class="input" style="min-width: 150px;">
						<option value="" if len(scopes) == 0 || scopesContains(scopes, "all") { selected }>All</option>
						<option value="symbols" if scopesContains(scopes, "symbols") { selected }>Symbols</option>
						<option value="sessions" if scopesContains(scopes, "sessions") { selected }>Sessions</option>
						<option value="memories" if scopesContains(scopes, "memories") { selected }>Memories</option>
						<option value="tasks" if scopesContains(scopes, "tasks") { selected }>Tasks</option>
					</select>
				</div>

				<div style="display: flex; align-items: center; gap: 0.5rem;">
					<input
						type="checkbox"
						name="rerank"
						id="rerank-checkbox"
						value="true"
						if rerank { checked }
					/>
					<label for="rerank-checkbox" style="font-size: 0.875rem; cursor: pointer;">
						Enable Reranking
					</label>
				</div>

				<button type="submit" class="btn btn-primary">
					<span id="search-spinner" class="htmx-indicator" style="margin-right: 0.5rem;">...</span>
					Search
				</button>
			</div>
		</form>
	</div>

	<!-- Stats -->
	if stats != nil && query != "" {
		<div class="grid-4 mb-4">
			<div class="stat-card">
				<div class="stat-value">{ fmt.Sprintf("%d", stats.TotalResults) }</div>
				<div class="stat-label">Results</div>
			</div>
			<div class="stat-card">
				<div class="stat-value">{ fmt.Sprintf("%d", len(stats.SourceCounts)) }</div>
				<div class="stat-label">Sources</div>
			</div>
			<div class="stat-card">
				<div class="stat-value" style={ templ.SafeCSS(fmt.Sprintf("color: %s;", rerankColor(stats.Reranked))) }>
					if stats.Reranked {
						Yes
					} else {
						No
					}
				</div>
				<div class="stat-label">Reranked</div>
			</div>
			<div class="stat-card">
				<div class="stat-value">{ fmt.Sprintf("%dms", stats.LatencyMS) }</div>
				<div class="stat-label">Latency</div>
			</div>
		</div>
	}

	<!-- Results by Source -->
	if query != "" {
		if len(results) == 0 {
			<div class="empty-state">
				<p>No results found for "{ query }"</p>
			</div>
		} else {
			@SearchResultsBySource(results)
		}
	}
}

templ SearchResultsBySource(results []SearchResult) {
	for _, source := range []string{"symbol", "session", "memory", "task"} {
		if sourceResults := filterBySource(results, source); len(sourceResults) > 0 {
			<div class="card mb-4">
				<h3 style={ templ.SafeCSS(fmt.Sprintf("color: %s; margin-bottom: 1rem;", sourceColor(source))) }>
					{ sourceIcon(source) } { titleCase(source) }s
					<span class="text-muted" style="font-size: 0.875rem; font-weight: normal;">({ fmt.Sprintf("%d", len(sourceResults)) })</span>
				</h3>

				<table class="table">
					<thead>
						<tr>
							<th style="width: 50px;">#</th>
							<th>Path/Name</th>
							<th style="width: 120px;">Similarity</th>
							<th style="width: 120px;">Rerank</th>
							<th style="width: 100px;">Final</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range sourceResults {
							<tr>
								<td class="text-muted">{ fmt.Sprintf("%d", r.Rank) }</td>
								<td>
									if r.Name != "" {
										<div style="font-weight: 500;">{ r.Name }</div>
									}
									<div class="mono text-muted" style="font-size: 0.75rem;">{ truncatePath(r.Path, 80) }</div>
								</td>
								<td>
									<div style="display: flex; align-items: center; gap: 0.5rem;">
										<div style="width: 50px; height: 4px; background: var(--bg-tertiary); border-radius: 2px; overflow: hidden;">
											<div style={ templ.SafeCSS(fmt.Sprintf("width: %d%%; height: 100%%; background: var(--accent);", int(r.Similarity*100))) }></div>
										</div>
										<span class="mono" style="font-size: 0.75rem;">{ fmt.Sprintf("%.0f%%", r.Similarity*100) }</span>
									</div>
								</td>
								<td>
									if r.RerankScore > 0 {
										<span class="chip chip-success" style="font-size: 0.75rem;">{ fmt.Sprintf("%.2f", r.RerankScore) }</span>
									} else {
										<span class="text-muted">-</span>
									}
								</td>
								<td>
									<span class="mono" style="font-weight: 500;">{ fmt.Sprintf("%.2f", r.FinalScore) }</span>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

func filterBySource(results []SearchResult, source string) []SearchResult {
	var filtered []SearchResult
	for _, r := range results {
		if r.Source == source {
			filtered = append(filtered, r)
		}
	}
	return filtered
}

func sourceColor(source string) string {
	switch source {
	case "symbol":
		return "var(--accent)"
	case "session":
		return "#a855f7" // purple
	case "memory":
		return "#eab308" // yellow
	case "task":
		return "var(--success)"
	default:
		return "var(--text)"
	}
}

func sourceIcon(source string) string {
	switch source {
	case "symbol":
		return "🔍"
	case "session":
		return "📋"
	case "memory":
		return "🧠"
	case "task":
		return "✅"
	default:
		return "📄"
	}
}

func rerankColor(reranked bool) string {
	if reranked {
		return "var(--success)"
	}
	return "var(--text-muted)"
}

func scopesContains(scopes []string, scope string) bool {
	for _, s := range scopes {
		if s == scope {
			return true
		}
	}
	return false
}

func truncatePath(path string, max int) string {
	if len(path) <= max {
		return path
	}
	return "..." + path[len(path)-max+3:]
}

func titleCase(s string) string {
	if len(s) == 0 {
		return s
	}
	if s[0] >= 'a' && s[0] <= 'z' {
		return string(s[0]-32) + s[1:]
	}
	return s
}
