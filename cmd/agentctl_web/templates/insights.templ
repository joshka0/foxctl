package templates

import "fmt"

templ Insights(data *InsightsData) {
	@Layout("Insights", "/insights") {
		@InsightsContent(data)
	}
}

templ InsightsContent(data *InsightsData) {
	<div class="page-header">
		<h1 class="page-title">Task Graph Insights</h1>
	</div>
	
	<div class="grid-3 mb-6">
		<div class="stat-card">
			<div class="stat-value">{ fmt.Sprintf("%d", len(data.Nodes)) }</div>
			<div class="stat-label">Total Nodes</div>
		</div>
		<div class="stat-card">
			<div class="stat-value" style="color: var(--warning);">{ fmt.Sprintf("%d", len(data.Cycles)) }</div>
			<div class="stat-label">Cycles Detected</div>
		</div>
		<div class="stat-card">
			<div class="stat-value" style="color: var(--accent);">{ fmt.Sprintf("%d", len(data.TopologicalOrder)) }</div>
			<div class="stat-label">Topo Order Length</div>
		</div>
	</div>
	
	if len(data.Cycles) > 0 {
		<div class="card mb-4" style="border-color: var(--warning);">
			<h3 style="color: var(--warning); margin-bottom: 1rem;">⚠️ Cycles Detected</h3>
			for i, cycle := range data.Cycles {
				<div style="margin-bottom: 0.5rem;">
					<span class="text-muted">Cycle { fmt.Sprintf("%d", i+1) }:</span>
					for j, node := range cycle {
						if j > 0 {
							<span class="text-muted"> → </span>
						}
						<span class="mono">{ node }</span>
					}
				</div>
			}
		</div>
	}
	
	<h2 style="margin-bottom: 1rem;">Top Nodes by PageRank</h2>
	if len(data.Nodes) == 0 {
		<div class="empty-state">
			<p>No graph data available</p>
		</div>
	} else {
		<div class="card" style="padding: 0; overflow: hidden;">
			<table class="table">
				<thead>
					<tr>
						<th>#</th>
						<th>Task ID</th>
						<th>PageRank</th>
						<th>Critical Path</th>
						<th>In/Out Degree</th>
					</tr>
				</thead>
				<tbody>
					for i, node := range limitNodes(data.Nodes, 15) {
						<tr style="cursor: default;">
							<td class="text-muted">{ fmt.Sprintf("%d", i+1) }</td>
							<td>
								<div class="mono" style="font-size: 0.75rem; color: var(--text-muted);">{ truncateID(node.TaskID) }</div>
								if node.Title != "" {
									<div style="font-weight: 500; margin-top: 0.25rem;">{ truncateString(node.Title, 50) }</div>
								}
							</td>
							<td>
								<div style="display: flex; align-items: center; gap: 0.5rem;">
									<div style="width: 60px; height: 6px; background: var(--bg-tertiary); border-radius: 3px; overflow: hidden;">
										<div style={ fmt.Sprintf("width: %d%%; height: 100%%; background: var(--accent);", int(node.PageRank*100)) }></div>
									</div>
									<span class="mono text-muted">{ fmt.Sprintf("%.4f", node.PageRank) }</span>
								</div>
							</td>
							<td>
								<span class="chip chip-info">{ fmt.Sprintf("%d", node.CriticalPathScore) }</span>
							</td>
							<td class="text-muted">
								{ fmt.Sprintf("%d / %d", node.InDegree, node.OutDegree) }
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

func limitNodes(nodes []GraphNode, max int) []GraphNode {
	if len(nodes) <= max {
		return nodes
	}
	return nodes[:max]
}
