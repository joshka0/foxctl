package templates

templ Reservations(reservations []Reservation, workspace string, workspaces []Workspace) {
	@Layout("Reservations", "/reservations", workspace, workspaces) {
		<div class="page-header">
			<h1 class="page-title">File Reservations</h1>
		</div>
		<div id="reservations-content">
			@ReservationsTable(reservations)
		</div>
	}
}

templ ReservationsTable(reservations []Reservation) {
	if len(reservations) == 0 {
		<div class="empty-state">
			<p>No active reservations</p>
			<p class="text-muted">File reservations appear when agents lock files for editing</p>
		</div>
	} else {
		<div class="card" style="padding: 0; overflow: hidden;">
			<table class="table">
				<thead>
					<tr>
						<th>Path</th>
						<th>Holder</th>
						<th>Mode</th>
						<th>Expires</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range reservations {
						<tr style="cursor: default;">
							<td class="mono">{ r.Path }</td>
							<td class="mono text-muted">{ r.Holder }</td>
							<td>
								@ReservationMode(r.Mode)
							</td>
							<td class="text-muted">{ formatTime(r.ExpiresAt) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ ReservationMode(mode string) {
	switch mode {
		case "exclusive":
			<span class="chip chip-error">🔒 Exclusive</span>
		case "shared":
			<span class="chip chip-info">🔗 Shared</span>
		default:
			<span class="chip chip-default">{ mode }</span>
	}
}
