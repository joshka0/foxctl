package templates

import "fmt"

templ Blackboard(records []BlackboardRecord, ns, topic string) {
	@Layout("Blackboard", "/blackboard") {
		<div class="page-header">
			<h1 class="page-title">Blackboard</h1>
			<div style="display: flex; gap: 0.5rem;">
				<input 
					type="text" 
					name="ns" 
					placeholder="Namespace"
					value={ ns }
					class="select"
					hx-get="/blackboard" 
					hx-target="#blackboard-content" 
					hx-trigger="change, keyup delay:500ms"
					hx-include="[name='topic']"
				/>
				<input 
					type="text" 
					name="topic" 
					placeholder="Topic"
					value={ topic }
					class="select"
					hx-get="/blackboard" 
					hx-target="#blackboard-content" 
					hx-trigger="change, keyup delay:500ms"
					hx-include="[name='ns']"
				/>
			</div>
		</div>
		<div id="blackboard-content">
			@BlackboardTable(records)
		</div>
	}
}

templ BlackboardTable(records []BlackboardRecord) {
	if len(records) == 0 {
		<div class="empty-state">
			<p>No blackboard records</p>
			<p class="text-muted">Blackboard stores shared state between agents</p>
		</div>
	} else {
		<div class="card" style="padding: 0; overflow: hidden;">
			<table class="table">
				<thead>
					<tr>
						<th>Namespace</th>
						<th>Topic</th>
						<th>Payload</th>
						<th>TTL</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range records {
						<tr style="cursor: default;">
							<td class="mono">{ r.NS }</td>
							<td class="mono">{ r.Topic }</td>
							<td>
								<pre style="margin: 0; max-width: 400px; overflow: hidden; text-overflow: ellipsis;">{ truncateString(r.Payload, 100) }</pre>
							</td>
							<td class="text-muted">{ formatTTL(r.TTLSec) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

func formatTTL(ttl int) string {
	if ttl <= 0 {
		return "∞"
	}
	if ttl < 60 {
		return fmt.Sprintf("%ds", ttl)
	}
	if ttl < 3600 {
		return fmt.Sprintf("%dm", ttl/60)
	}
	return fmt.Sprintf("%dh", ttl/3600)
}
