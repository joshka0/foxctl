package templates

import "path/filepath"

type navItem struct {
	Path  string
	Label string
	Icon  string
}

var navItems = []navItem{
	{"/jobs", "Jobs", "📋"},
	{"/tasks", "Tasks", "✅"},
	{"/search", "Search", "🔍"},
	{"/stats", "Stats", "📊"},
	{"/insights", "Insights", "✨"},
	{"/mailbox", "Mailbox", "📬"},
	{"/reservations", "Reservations", "🔒"},
	{"/blackboard", "Blackboard", "📝"},
	{"/sqlite", "SQLite", "🗄️"},
}

templ Nav(currentPath string, workspace string, workspaces []Workspace) {
	<nav class="sidebar">
		<div class="nav-links">
			<div class="logo">
				⚡ agentctl
			</div>
			for _, item := range navItems {
				<a
					href={ templ.SafeURL(item.Path) }
					class={ "nav-item", templ.KV("active", currentPath == item.Path) }
					hx-boost="true"
					hx-target=".main"
					hx-swap="innerHTML"
				>
					<span>{ item.Icon }</span>
					<span>{ item.Label }</span>
				</a>
			}
		</div>
		<div class="workspace-info">
			<div class="workspace-label">Workspace</div>
			<select
				class="workspace-select"
				name="workspace"
				hx-get="/switch-workspace"
				hx-target="body"
				hx-swap="outerHTML"
				title={ workspace }
			>
				<option value="" if workspace == "" { selected }>All workspaces</option>
				for _, ws := range workspaces {
					<option
						value={ ws.Path }
						if ws.Path == workspace { selected }
						title={ ws.Path }
					>
						{ ws.Name }
					</option>
				}
			</select>
		</div>
	</nav>
}

func shortPath(path string) string {
	if path == "" {
		return "(all)"
	}
	// Show just the last directory name
	base := filepath.Base(path)
	if base == "." || base == "/" {
		return path
	}
	return base
}
