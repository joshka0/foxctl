package templates

type navItem struct {
	Path  string
	Label string
	Icon  string
}

var navItems = []navItem{
	{"/jobs", "Jobs", "📋"},
	{"/tasks", "Tasks", "✅"},
	{"/stats", "Stats", "📊"},
	{"/insights", "Insights", "✨"},
	{"/mailbox", "Mailbox", "📬"},
	{"/reservations", "Reservations", "🔒"},
	{"/blackboard", "Blackboard", "📝"},
	{"/sqlite", "SQLite", "🗄️"},
}

templ Nav(currentPath string) {
	<nav class="sidebar">
		<div class="logo">
			⚡ agentctl
		</div>
		for _, item := range navItems {
			<a 
				href={ templ.SafeURL(item.Path) } 
				class={ "nav-item", templ.KV("active", currentPath == item.Path) }
				hx-boost="true"
				hx-target=".main"
				hx-swap="innerHTML"
			>
				<span>{ item.Icon }</span>
				<span>{ item.Label }</span>
			</a>
		}
	</nav>
}
