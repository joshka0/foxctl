package templates

import "fmt"

templ Stats(stats *JobStats) {
	@Layout("Stats", "/stats") {
		@StatsContent(stats)
	}
}

templ StatsContent(stats *JobStats) {
	<div class="page-header">
		<h1 class="page-title">Statistics</h1>
	</div>
	
	<div class="grid-4 mb-6">
		<div class="stat-card">
			<div class="stat-value">{ fmt.Sprintf("%d", stats.Total) }</div>
			<div class="stat-label">Total Jobs</div>
		</div>
		<div class="stat-card">
			<div class="stat-value" style="color: var(--success);">{ fmt.Sprintf("%d", stats.ByState["ok"]) }</div>
			<div class="stat-label">Successful</div>
		</div>
		<div class="stat-card">
			<div class="stat-value" style="color: var(--error);">{ fmt.Sprintf("%d", stats.ByState["error"]) }</div>
			<div class="stat-label">Failed</div>
		</div>
		<div class="stat-card">
			<div class="stat-value" style="color: var(--accent);">{ fmt.Sprintf("%d", stats.ByState["running"]) }</div>
			<div class="stat-label">Running</div>
		</div>
	</div>
	
	<div class="grid-3 mb-6">
		<div class="stat-card">
			<div class="stat-value">{ fmt.Sprintf("%d", stats.Recent.LastHour) }</div>
			<div class="stat-label">Last Hour</div>
		</div>
		<div class="stat-card">
			<div class="stat-value">{ fmt.Sprintf("%d", stats.Recent.LastDay) }</div>
			<div class="stat-label">Last 24 Hours</div>
		</div>
		<div class="stat-card">
			<div class="stat-value">{ fmt.Sprintf("%d", len(stats.ByCommand)) }</div>
			<div class="stat-label">Unique Commands</div>
		</div>
	</div>
	
	<h2 style="margin-bottom: 1rem;">Jobs by Command</h2>
	<div class="card" style="padding: 0; overflow: hidden;">
		<table class="table">
			<thead>
				<tr>
					<th>Command</th>
					<th>Count</th>
					<th>Distribution</th>
				</tr>
			</thead>
			<tbody>
				for cmd, count := range stats.ByCommand {
					<tr style="cursor: default;">
						<td class="mono">{ cmd }</td>
						<td>{ fmt.Sprintf("%d", count) }</td>
						<td>
							<div style="width: 200px; height: 6px; background: var(--bg-tertiary); border-radius: 3px; overflow: hidden;">
								<div style={ fmt.Sprintf("width: %d%%; height: 100%%; background: var(--accent);", percent(count, stats.Total)) }></div>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

func percent(part, total int) int {
	if total == 0 {
		return 0
	}
	return (part * 100) / total
}
