# Example Turso Configuration for foxctl
# Copy this file to .env and fill in your actual values
# Then source it: source .env

# ============================================
# Database Driver Selection
# ============================================
# Options: sqlite, turso
# Default: sqlite

# Use Turso for all databases
export FOXCTL_CACHE_DB_DRIVER=turso
export FOXCTL_JOBS_DB_DRIVER=turso
export FOXCTL_MEMORY_DB_DRIVER=turso

# Or mix and match (e.g., SQLite for cache/jobs, Turso for memory)
# export FOXCTL_CACHE_DB_DRIVER=sqlite
# export FOXCTL_JOBS_DB_DRIVER=sqlite
# export FOXCTL_MEMORY_DB_DRIVER=turso

# ============================================
# Turso Configuration
# ============================================

# Method 1: Separate databases (recommended for production)
# Get URLs and tokens with:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>

export FOXCTL_CACHE_DB_URL=libsql://foxctl-cache-yourorg.turso.io
export FOXCTL_CACHE_DB_TOKEN=your_cache_token_here

export FOXCTL_JOBS_DB_URL=libsql://foxctl-jobs-yourorg.turso.io
export FOXCTL_JOBS_DB_TOKEN=your_jobs_token_here

export FOXCTL_MEMORY_DB_URL=libsql://foxctl-memory-yourorg.turso.io
export FOXCTL_MEMORY_DB_TOKEN=your_memory_token_here

# Method 2: Single database with fallback (simpler for development)
# Uncomment to use a single Turso database for all stores:
# export FOXCTL_TURSO_URL=libsql://foxctl-yourorg.turso.io
# export FOXCTL_TURSO_TOKEN=your_token_here

# ============================================
# Vector Search (Memory Database Only)
# ============================================
# Enable native vector search for AI/LLM features
# Requires: Turso group with vector support enabled

export FOXCTL_MEMORY_VECTOR_SEARCH=true

# Vector dimensions (must match your embedding model)
# Common values:
#   384  - all-MiniLM-L6-v2 (default, good balance)
#   768  - BERT base, sentence-transformers/all-mpnet-base-v2
#   1024 - Voyage AI models (voyage-code-3, voyage-3.5)
#   1536 - OpenAI ada-002, text-embedding-ada-002
#   3072 - OpenAI text-embedding-3-large, Gemini embedding-001
export FOXCTL_MEMORY_VECTOR_DIMS=1024

# ============================================
# Embedding Model Configuration
# ============================================
# Override default models per scope (optional)
# Code scopes (symbols): voyage-code-3 (best for code retrieval, $0.18/1M)
# Text scopes (memory, tasks, sessions, codemaps): voyage-3.5 (good balance, $0.06/1M)

# export FOXCTL_EMBEDDING_MODEL_CODE=voyage-code-3
# export FOXCTL_EMBEDDING_MODEL_TEXT=voyage-3.5

# API keys for embedding providers
export VOYAGE_API_KEY=your_voyage_api_key_here
# export GEMINI_API_KEY=your_gemini_api_key_here  # Fallback if Voyage unavailable

# ============================================
# SQLite Configuration (if using SQLite)
# ============================================
# These are used when FOXCTL_<DB>_DB_DRIVER=sqlite

# Custom paths (optional, defaults to ~/.foxctl/<db>.db)
# export FOXCTL_CACHE_DB_PATH=/custom/path/cache.db
# export FOXCTL_JOBS_DB_PATH=/custom/path/jobs.db
# export FOXCTL_MEMORY_DB_PATH=/custom/path/memory.db

# WAL mode (optional, default: true)
# export FOXCTL_CACHE_DB_WAL=true
# export FOXCTL_JOBS_DB_WAL=true
# export FOXCTL_MEMORY_DB_WAL=true

# Busy timeout in milliseconds (optional, default: 5000)
# export FOXCTL_CACHE_DB_TIMEOUT=5000
# export FOXCTL_JOBS_DB_TIMEOUT=5000
# export FOXCTL_MEMORY_DB_TIMEOUT=5000

# ============================================
# Setup Instructions
# ============================================

# 1. Install Turso CLI:
#    curl -sSfL https://get.tur.so/install.sh | bash

# 2. Login to Turso:
#    turso auth signup  # or: turso auth login

# 3. Create databases:
#    turso db create foxctl-cache
#    turso db create foxctl-jobs
#    turso db create foxctl-memory

# 4. For vector search, create a vector-enabled group:
#    turso group create vector-group
#    turso group update vector-group  # Ensure latest version
#    turso db create foxctl-memory --group vector-group

# 5. Get database URLs:
#    turso db show foxctl-cache --url
#    turso db show foxctl-jobs --url
#    turso db show foxctl-memory --url

# 6. Create authentication tokens:
#    turso db tokens create foxctl-cache
#    turso db tokens create foxctl-jobs
#    turso db tokens create foxctl-memory

# 7. Fill in the values above and source this file:
#    cp .env.turso.example .env
#    # Edit .env with your values
#    source .env

# 8. Migrate existing data (if you have SQLite databases):
#    See docs/turso-migration.md for migration instructions

# ============================================
# Verification
# ============================================

# Check your configuration:
# echo "Cache driver: $FOXCTL_CACHE_DB_DRIVER"
# echo "Jobs driver: $FOXCTL_JOBS_DB_DRIVER"
# echo "Memory driver: $FOXCTL_MEMORY_DB_DRIVER"
# echo "Memory vector search: $FOXCTL_MEMORY_VECTOR_SEARCH"

# Test Turso connection:
# turso db shell foxctl-cache
# turso db shell foxctl-jobs
# turso db shell foxctl-memory

# ============================================
# Security Notes
# ============================================

# IMPORTANT:
# - Never commit this file with real tokens to version control
# - Add .env to .gitignore
# - Use different tokens for development and production
# - Rotate tokens regularly using: turso db tokens create <db>
# - For production, use secret management (e.g., AWS Secrets Manager)

# Recommended .gitignore entries:
# .env
# .env.local
# .env.*.local
# *.token
