#!/usr/bin/env bash
# Auto-refresh the repo graph index after switching branches so search stays
# current. Fire-and-forget: never block or fail the git operation.
#
# git passes: $1 = prev HEAD, $2 = new HEAD, $3 = branch-checkout flag (1) vs
# file-checkout (0). Only reindex on branch checkouts.
set -euo pipefail

[ "${3:-0}" = "1" ] || exit 0

for candidate in /usr/local/go/bin "$HOME/go/bin" "$HOME/.local/bin"; do
    case ":${PATH}:" in
        *":$candidate:"*) ;;
        *) export PATH="$candidate:$PATH" ;;
    esac
done

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] || exit 0
[ -x "$root/bin/foxctl" ] || exit 0

( cd "$root" && ./bin/foxctl index repo build --workspace . --go --typescript --elixir \
    >/tmp/foxctl-reindex.log 2>&1 & ) || true
exit 0
