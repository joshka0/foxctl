# foxctl runner image for agent-ci
# Based on official GitHub Actions runner with Go toolchain added
FROM ghcr.io/actions/actions-runner:latest

USER root

ENV DEBIAN_FRONTEND=noninteractive
ENV GOROOT=/usr/local/go
ENV PATH=/usr/local/go/bin:/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Install build dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    make \
    gcc \
    libc6-dev \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Go 1.26.1
ADD https://go.dev/dl/go1.26.1.linux-arm64.tar.gz /tmp/go.tar.gz
RUN tar -C /usr/local -xzf /tmp/go.tar.gz && rm /tmp/go.tar.gz

# Install Go tools
RUN go install mvdan.cc/gofumpt@v0.7.0 \
    && go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.8.0

USER runner
