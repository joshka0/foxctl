          "lineContent": "func (d *dispatcher) Dispatch(ctx context.Context, input Input) (Result, error) {",
          "title": "Hook dispatcher entry",
          "description": "Routes events to matching hooks and merges outputs"
        },
        {
          "id": "6b",
          "path": "/Users/jkatigbak/repos/personal/agentctl/internal/hooks/dispatcher.go",
          "lineNumber": 170,
          "lineContent": "output, err := d.runner.Run(hookCtx, entryHook, hookInput)",
