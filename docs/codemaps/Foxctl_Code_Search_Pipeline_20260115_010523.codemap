          "lineContent": "func run(ctx context.Context, rc *skillmain.RunContext, in input) error {",
          "title": "Context Ripgrep Entry",
          "description": "Main skill logic for ripgrep with block expansion"
        },
        {
          "id": "5b",
          "path": "skills/code_context_ripgrep/main.go",
          "lineNumber": 105,
          "lineContent": "result, err := ripgrep.SearchJSON(ctx, opts)",
          "title": "Execute Ripgrep Search",
          "description": "Runs ripgrep to find pattern matches"
        },
        {
          "id": "5c",
          "path": "skills/code_context_ripgrep/main.go",
          "lineNumber": 144,
          "lineContent": "expander := NewExpander(lang, in.MaxBlockLines)",
          "title": "Create Language Expander",
          "description": "Creates expander for language-specific block detection"
        },
        {
          "id": "5d",
          "path": "skills/code_context_ripgrep/main.go",
          "lineNumber": 146,
          "lineContent": "fileBlocks := expander.ExpandMatches(file, lines, fileMatches)",
          "title": "Expand to Code Blocks",
          "description": "Expands individual matches to surrounding code blocks"
        },
        {
          "id": "5e",
          "path": "skills/code_context_ripgrep/expander.go",
          "lineNumber": 80,
          "lineContent": "start, end, header, symbolName, symbolKind := e.findBlockBoundaries(lines, lineIdx)",
          "title": "Find Block Boundaries",
