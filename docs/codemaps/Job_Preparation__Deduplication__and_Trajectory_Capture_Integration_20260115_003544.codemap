        },
        {
          "id": "6b",
          "path": "internal/trajectorycapture/capture.go",
          "lineNumber": 282,
          "lineContent": "kind := trajectory.EventKindToolResult",
          "title": "Determine event kind",
          "description": "Maps to tool_result, hook_result, task_transition, or review based on command"
        },
        {
