          "lineNumber": 291,
          "lineContent": "row := tx.QueryRowContext(ctx, `\n        SELECT id, command, args_json, args_hash, state, result_path, error, created_at, updated_at\n        FROM jobs\n        WHERE args_hash = ?\n        ORDER BY created_at DESC\n        LIMIT 1`, job.ArgsHash)",
