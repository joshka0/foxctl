        {
          "id": "1g",
          "path": "internal/storage/jobs/persist/store.go",
          "lineNumber": 330,
          "lineContent": "_, err = tx.ExecContext(ctx, `\n        INSERT INTO jobs (id, command, args_json, args_hash, state, result_path, error, created_at, updated_at)\n        VALUES (?, ?, ?, ?, ?, '', '', ?, ?)`,\n\t\tjob.ID, job.Command, job.ArgsJSON, job.ArgsHash, job.State, sqlutil.FormatTimestamp(job.CreatedAt), sqlutil.FormatTimestamp(job.UpdatedAt))",
