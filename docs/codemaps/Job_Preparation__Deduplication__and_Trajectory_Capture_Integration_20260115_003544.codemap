          "lineNumber": 356,
          "lineContent": "_, err := c.store.InsertEvent(ctx, trajectory.Event{",
          "title": "Insert result event",
          "description": "Creates trajectory_events record with inline summary and artifact reference"
        },
        {
          "id": "6e",
          "path": "internal/trajectorycapture/capture.go",
          "lineNumber": 370,
          "lineContent": "if env.Status == envelope.StatusOK {",
          "title": "Determine trajectory outcome",
          "description": "Maps envelope status to trajectory status (ok/error)"
        },
        {
          "id": "6f",
          "path": "internal/trajectorycapture/capture.go",
          "lineNumber": 378,
          "lineContent": "return c.store.UpdateTrajectory(ctx, c.traj)",
          "title": "Update trajectory with final status",
          "description": "Persists trajectory status, summary, and task IDs after result capture"
