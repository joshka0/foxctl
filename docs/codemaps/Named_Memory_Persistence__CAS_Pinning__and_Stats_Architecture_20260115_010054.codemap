        {
          "id": "2b",
          "path": "/Users/jkatigbak/repos/personal/agentctl/internal/storage/memory/store.go",
          "lineNumber": 376,
          "lineContent": "if _, err := s.db.ExecContext(ctx, `DELETE FROM named_memory WHERE name = ? AND workspace = ?`, name, workspace); err != nil {",
