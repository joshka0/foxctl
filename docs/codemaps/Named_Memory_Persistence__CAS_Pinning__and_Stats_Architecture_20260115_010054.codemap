          "lineNumber": 500,
          "lineContent": "func CollectDigests(result []byte) []string {",
          "title": "Extract digests helper",
          "description": "Parses envelope JSON to find artifact references"
        },
        {
          "id": "3d",
          "path": "/Users/jkatigbak/repos/personal/agentctl/internal/adapters/artifacts/artifacts.go",
          "lineNumber": 11,
          "lineContent": "func Digests(result []byte) []string {",
