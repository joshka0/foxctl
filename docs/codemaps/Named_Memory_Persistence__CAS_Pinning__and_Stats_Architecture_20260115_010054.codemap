        },
        {
          "id": "3e",
          "path": "/Users/jkatigbak/repos/personal/agentctl/internal/storage/cache/store.go",
          "lineNumber": 441,
          "lineContent": "if _, err := s.db.ExecContext(ctx, `DELETE FROM auto_cache WHERE cache_key = ?`, d.key); err != nil {",
          "title": "Delete expired cache entry",
          "description": "Eviction removes entry from auto_cache during cleanup"
