          "path": "skills/hooks_file_guard/main.go",
          "lineNumber": 123,
          "lineContent": "return emitOutput(rc, hooks.Output{",
          "title": "Block operation on conflict",
          "description": "Returns block decision with conflict details when strict mode enabled"
        },
        {
