        },
        {
          "id": "6d",
          "path": "skills/hooks_file_guard/main.go",
          "lineNumber": 110,
          "lineContent": "conflicts, err := boardStore.CheckConflicts(ctx, workspaceID, []string{relPath}, actorID, agent.ReservationModeExclusive)",
          "title": "Check for file reservation conflicts",
          "description": "Queries blackboard store to see if another agent has reserved this file"
        },
        {
