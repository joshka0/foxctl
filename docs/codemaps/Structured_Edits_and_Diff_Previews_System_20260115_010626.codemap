      "locations": [
        {
          "id": "3a",
          "path": "skills/code_diff/main.go",
          "lineNumber": 99,
          "lineContent": "hunks := computeDiff(oldLines, newLines, in.ContextLines)",
          "title": "Diff Computation",
          "description": "Computes diff using longest common subsequence algorithm"
        },
        {
          "id": "3b",
          "path": "skills/code_diff/main.go",
          "lineNumber": 181,
          "lineContent": "lcs := longestCommonSubsequence(oldLines, newLines)",
