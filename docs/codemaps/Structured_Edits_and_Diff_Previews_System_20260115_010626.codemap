unk\"]\n        5d[\"5d: Context Validation\u003cbr/\u003everify context matches\"]\n        5e[\"5e: Atomic Update\u003cbr/\u003ef.WriteString\"]\n    end\n\n    1a --\u003e|routes to| 1c\n    1c --\u003e|resolves paths| 1d\n    1d --\u003e|applies edits| 1e\n    1e --\u003e|uses symbol detection| 4d\n    1e --\u003e|returns edited lines| 1f\n    1f --\u003e|generates diff| 4a\n    1f --\u003e|backs up original| 4b\n    1f --\u003e|writes file| 4c\n    1f --\u003e|emits result| 4e\n\n    2a --\u003e|finds candidates| 2b\n    2b --\u003e|scores matches| 2c\n    2c --\u003e|returns scores| 2d\n    2d --\u003e|applies replacements| 2e\n    2e --\u003e|generates diff| 4a\n    2e --\u003e|backs up original| 4b\n    2e --\u003e|writes file| 4c\n\n    3a --\u003e|computes LCS| 3b\n    3b --\u003e|backtracks to| 3c\n    3c --\u003e|builds hunks| 3d\n    3d --\u003e|formats output| 3e\n\n    3d --\u003e|produces structured diff| 5a\n    5a --\u003e|parses hunks| 5b\n    5b --\u003e|applies each hunk| 5c\n    5c --\u003e|validates context| 5d\n    5d --\u003e|writes changes| 5e"
