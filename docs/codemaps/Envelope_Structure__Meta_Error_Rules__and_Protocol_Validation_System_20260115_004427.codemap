          "title": "Status-Based Validation",
          "description": "Enforces status-specific rules: ok status must not have error fields, error status requires code and message"
        },
        {
          "id": "1e",
          "path": "internal/domain/envelope/envelope.go",
          "lineNumber": 199,
          "lineContent": "if env.Error.Code != \"\" || env.Error.Message != \"\" {",
          "title": "OK Status Error Field Check",
          "description": "Validates that success envelopes don't contain error fields - Core Profile invariant"
        },
        {
          "id": "1f",
