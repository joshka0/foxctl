        },
        {
          "id": "1c",
          "path": "internal/domain/envelope/envelope.go",
          "lineNumber": 190,
          "lineContent": "func Validate(env Envelope) error {",
          "title": "Base Validation Entry",
          "description": "Core Profile v1 validation - checks version, status, command, timestamps, error fields"
        },
        {
          "id": "1d",
