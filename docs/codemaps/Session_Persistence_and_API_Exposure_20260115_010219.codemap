          "lineNumber": 81,
          "lineContent": "sessionList, err := store.List(r.Context(), opts)",
          "title": "Query database",
          "description": "Executes SELECT with WHERE and LIMIT clauses"
        },
        {
          "id": "4e",
          "path": "internal/interfaces/web/api/sessions.go",
