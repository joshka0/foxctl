          "lineContent": "mux.HandleFunc(\"/api/sessions\", api.SessionsListHandler(s.cfg, s.log))",
          "title": "Register list route",
          "description": "Mounts handler at /api/sessions endpoint"
        },
        {
          "id": "4b",
