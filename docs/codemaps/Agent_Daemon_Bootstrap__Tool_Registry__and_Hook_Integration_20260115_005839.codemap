          "lineContent": "stdout, stderr, err := runner.RunWithOptions(ctx, runner.RunOptions{",
          "title": "Runner invocation",
          "description": "Calls unified runner with manifest, artifact path, and input"
        },
        {
          "id": "6c",
          "path": "internal/execution/runner/runner.go",
          "lineNumber": 33,
          "lineContent": "func buildSkillEnv(baseEnv []string, workspace string, propagateSessionVars bool) []string {",
          "title": "Environment building",
          "description": "Constructs skill environment with FOXCTL_SESSION_ID and other context vars"
        },
        {
          "id": "6d",
