          "lineNumber": 350,
          "lineContent": "if len(preOutput.UpdatedToolInput) \u003e 0 {",
          "title": "Tool input mutation",
          "description": "Applies hook-provided mutations to tool arguments"
        },
        {
          "id": "4e",
