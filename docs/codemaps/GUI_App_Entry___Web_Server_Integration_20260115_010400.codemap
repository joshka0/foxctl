      4f[\"4f: message process\"]\n        4g[\"4g: response broadcast\"]\n        4a --\u003e 4b\n        4c --\u003e 4d --\u003e 4e --\u003e 4f --\u003e 4g\n    end\n\n    subgraph StaticFiles[\"Production Static Files\"]\n        7a[\"7a: build script\"]\n        7b[\"7b: ui-dir flag\"]\n        7c[\"7c: static check\"]\n        7d[\"7d: FileServer create\"]\n        7e[\"7e: route precedence\"]\n        7a --\u003e 7b --\u003e 7c --\u003e 7d --\u003e 7e\n    end\n\n    1f --\u003e|dev: proxies through| 6a\n    1f --\u003e|prod: direct| 5f\n    6b --\u003e|proxies /api| 2d\n    6c --\u003e|proxies /ws| 4c\n    2c --\u003e|dev: via Vite| 6b\n    2c --\u003e|prod: direct| 2d\n    3b --\u003e|dev: via Vite| 6a\n    3b --\u003e|prod: direct| 3c\n    4b --\u003e|dev: via Vite| 6c\n    4b --\u003e|prod: direct| 4c\n    5d --\u003e|registers| 2d\n    5d --\u003e|registers| 3c\n    5d --\u003e|registers| 4c\n    5d --\u003e|registers| 7e\n    5f --\u003e|serves| 7d\n\n    style Frontend fill:#fcc2d7\n    style DevSetup fill:#ffec99\n    style WebServer fill:#a5d8ff\n    style JobsAPI fill:#b2f2bb\n    style SSESystem fill:#d0bfff\n    style ConsoleWS fill:#ffd8a8\n    style StaticFiles fill:#99e9f2"
