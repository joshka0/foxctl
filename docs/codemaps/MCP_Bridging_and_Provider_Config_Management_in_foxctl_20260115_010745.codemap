          "lineNumber": 42,
          "lineContent": "c, err := client.NewStdioMCPClient(cfg.ServerCmd, env, cfg.ServerArgs...)",
          "title": "Stdio transport selection",
          "description": "Creates stdio client for local MCP server processes"
        },
        {
          "id": "1e",
          "path": "skills/mcp_bridge/main.go",
          "lineNumber": 133,
          "lineContent": "toolResult, err := mcpClient.CallTool(ctx, mcp.CallToolRequest{",
