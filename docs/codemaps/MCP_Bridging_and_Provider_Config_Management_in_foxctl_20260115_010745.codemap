        },
        {
          "id": "1c",
          "path": "internal/adapters/skillslib/mcputil/mcputil.go",
          "lineNumber": 25,
          "lineContent": "if cfg.ServerURL != \"\" {",
          "title": "HTTP/SSE transport selection",
          "description": "Chooses HTTP client for remote MCP servers"
        },
        {
          "id": "1d",
