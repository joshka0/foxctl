          "path": "internal/indexing/embedding/store.go",
          "lineNumber": 129,
          "lineContent": "contentDigest := computeDigest(sym.Content)",
          "title": "Compute Content Digest",
          "description": "Generates SHA256 hash for deduplication of unchanged content"
