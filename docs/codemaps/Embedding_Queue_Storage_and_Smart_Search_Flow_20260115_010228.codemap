          "lineNumber": 149,
          "lineContent": "res, err := stmt.ExecContext(ctx,\n\t\t\tid, req.WorkspaceID, sym.SymbolID, sym.FilePath, sym.SymbolName,\n\t\t\tsym.Content, contentDigest, priority, nowStr, nowStr,\n\t\t)",
          "title": "Insert Job",
