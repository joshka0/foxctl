          "lineNumber": 134,
          "lineContent": "err := tx.QueryRowContext(ctx, `\n\t\t\t\tSELECT EXISTS(\n\t\t\t\t\tSELECT 1 FROM symbol_embeddings\n\t\t\t\t\tWHERE workspace_id = ? AND symbol_id = ? AND content_digest = ?\n\t\t\t\t)\n\t\t\t`, req.WorkspaceID, sym.SymbolID, contentDigest).Scan(\u0026exists)",
          "title": "Check Existing Embedding",
          "description": "Queries if embedding already exists with same content digest to skip duplicate work"
        },
        {
