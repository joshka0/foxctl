{
  "name": "@agentctl/gui-svelte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "server": "agentctl web serve --dev-cors",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:fast": "svelte-check --no-tsconfig --diagnostic-sources \"svelte,css\""
  },
  "dependencies": {
    "@agentctl/data": "workspace:*",
    "@tanstack/svelte-query": "^5.64.2",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.469.0",
    "svelte": "^4.2.19",
    "svelte-spa-router": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
