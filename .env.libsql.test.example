# Local libSQL Configuration for Testing
# This configuration uses local libSQL files with vector search support
# Perfect for integration tests, unit tests, and local development
# No cloud connection or Turso account required!

# ============================================
# Use Local libSQL (File-Based)
# ============================================

# Use local libSQL for all databases
export AGENTCTL_CACHE_DB_DRIVER=libsql
export AGENTCTL_JOBS_DB_DRIVER=libsql
export AGENTCTL_MEMORY_DB_DRIVER=libsql

# ============================================
# Database Paths (Optional)
# ============================================
# If not specified, defaults to:
#   ~/.agentctl/cache.libsql
#   ~/.agentctl/jobs.libsql
#   ~/.agentctl/memory.libsql

# Custom paths (optional):
# export AGENTCTL_CACHE_DB_PATH=/tmp/test-cache.libsql
# export AGENTCTL_JOBS_DB_PATH=/tmp/test-jobs.libsql
# export AGENTCTL_MEMORY_DB_PATH=/tmp/test-memory.libsql

# ============================================
# Vector Search (Memory Database)
# ============================================
# Enable vector search locally (no cloud required!)
export AGENTCTL_MEMORY_VECTOR_SEARCH=true

# Vector dimensions (match your embedding model)
export AGENTCTL_MEMORY_VECTOR_DIMS=384

# ============================================
# Benefits of Local libSQL
# ============================================

# ✓ Vector search support (just like Turso!)
# ✓ No internet connection required
# ✓ No cloud credentials needed
# ✓ Perfect for CI/CD pipelines
# ✓ Fast local testing
# ✓ Same API as Turso (easy transition)
# ✓ Compatible with BM25, vector, and hybrid search

# ============================================
# Usage
# ============================================

# 1. Copy this file:
#    cp .env.libsql.test.example .env.test

# 2. Source it in your tests:
#    source .env.test
#    go test ./...

# 3. Or use in CI/CD:
#    # .github/workflows/test.yml
#    - name: Run tests with libSQL
#      env:
#        AGENTCTL_MEMORY_DB_DRIVER: libsql
#        AGENTCTL_MEMORY_VECTOR_SEARCH: true
#      run: go test -v ./...

# ============================================
# Comparison: SQLite vs libSQL vs Turso
# ============================================

# SQLite (standard):
# - Local file-based
# - NO vector search
# - Fast and simple
# - Good for basic testing

# libSQL (local):
# - Local file-based
# - YES vector search! ✓
# - Same features as Turso
# - Perfect for testing with vectors
# - No cloud needed

# Turso (cloud):
# - Cloud-hosted
# - YES vector search ✓
# - Distributed/replicated
# - Production-ready
# - Requires internet & token

# ============================================
# Testing Strategy
# ============================================

# Development:
#   Use SQLite for simple tests (fast, no vectors)
#   Use libSQL for vector/search tests (local)

# CI/CD:
#   Use libSQL (no secrets, full features)

# Production:
#   Use Turso (cloud, scalable, replicated)

# ============================================
# Clean Up Test Files
# ============================================

# After running tests, clean up:
# rm ~/.agentctl/*.libsql
# rm /tmp/test-*.libsql
