FROM golang:1.25

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    git \
    make \
    gcc \
    libc6-dev \
    libsqlite3-dev \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g coderabbit

WORKDIR /workspace

COPY go.mod go.sum ./

# Pre-warm module cache and install tools used by CI
RUN go mod download \
    && go install mvdan.cc/gofumpt@v0.7.0 \
    && go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.8.0

ENV CGO_ENABLED=1
