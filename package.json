{
  "name": "agentctl-ts",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:tui": "bun run --cwd packages/tui dev",
    "dev:gui": "bun run --cwd packages/gui dev",
    "dev:server": "bun run --cwd packages/gui server",
    "dev:all": "bun run --cwd packages/gui dev:all",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck"
  }
}
