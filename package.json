{
  "name": "agentctl-ts",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:tui": "bun run --cwd packages/tui-agent dev",
    "dev:gui": "bun run --cwd packages/gui-agent dev",
    "dev:gui-auth-gateway": "bun run --cwd packages/gui-auth-gateway dev",
    "dev:server": "go run ./cmd/agentctl web serve --dev-cors",
    "dev:all": "make gui-agent",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:fast": "tsgo --noEmit",
    "lint": "oxlint packages/",
    "lint:fix": "oxlint packages/ --fix",
    "check": "bun run lint && bun run typecheck:fast"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260103.1",
    "oxlint": "1.36.0"
  }
}
