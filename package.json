{
  "name": "foxctl-ts",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "factory:model:add": "bun scripts/factory-model-add.ts",
    "dev:tui": "echo 'The TypeScript TUI is archived under docs/archive/source/packages/tui-agent. Use: make go-tui-agent'",
    "dev:foxterm": "bun run --cwd packages/foxterm dev",
    "dev:gui": "bun run --cwd packages/gui-agent dev",
    "dev:gui-auth-gateway": "bun run --cwd packages/gui-auth-gateway dev",
    "dev:docs": "bun run --cwd packages/docs-site dev",
    "dev:server": "go run ./cmd/foxctl web serve --dev-cors --atcp",
    "dev:atcpd": "go run ./cmd/atcpd --data-dir $HOME/.foxctl/atcp",
    "dev:all": "make gui-agent",
    "build:docs": "bun run --cwd packages/docs-site build",
    "check:docs": "bun run --cwd packages/docs-site check",
    "setup:docs:pages": "bun scripts/cloudflare-pages-docs-setup.mjs",
    "setup:docs:pages:apply": "bun scripts/cloudflare-pages-docs-setup.mjs --apply",
    "deploy:docs:pages": "scripts/cloudflare-pages-docs-deploy.sh",
    "bench:go": "scripts/run-go-benchmarks.sh",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:fast": "tsgo --noEmit",
    "check:frontend": "bun run --cwd packages/data typecheck && bun run --cwd packages/gui-agent lint && bun run --cwd packages/gui-agent build && bun run --cwd packages/gui-agent test && bun run --cwd packages/foxterm typecheck && bun run --cwd packages/gui-auth-gateway typecheck",
    "unused:frontend": "bun run check:frontend && bun run lint && bun run dead:frontend",
    "dead:frontend": "bun scripts/check-frontend-dead-exports.ts --strict",
    "lint": "oxlint packages/",
    "lint:fix": "oxlint packages/ --fix",
    "check": "bun run lint && bun run typecheck:fast"
  },
  "devDependencies": {
    "@redwoodjs/agent-ci": "0.7.1",
    "@typescript/native-preview": "7.0.0-dev.20260103.1",
    "oxlint": "1.36.0"
  },
  "overrides": {
    "defu": "6.1.7",
    "diff": "8.0.4",
    "postcss": "8.5.14",
    "rollup": "4.60.3",
    "vite": "7.3.2"
  }
}
