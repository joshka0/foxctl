{
  "name": "foxctl-ts",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "factory:model:add": "bun scripts/factory-model-add.ts",
    "dev:tui": "echo 'The TypeScript TUI is archived under archive/packages/tui-agent. Use: make go-tui-agent'",
    "dev:foxterm": "bun run --cwd packages/foxterm dev",
    "dev:gui": "bun run --cwd packages/gui-agent dev",
    "dev:gui-auth-gateway": "bun run --cwd packages/gui-auth-gateway dev",
    "dev:server": "go run ./cmd/foxctl web serve --dev-cors",
    "dev:atcpd": "go run ./cmd/atcpd --data-dir $HOME/.foxctl/atcp",
    "dev:all": "make gui-agent",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:fast": "tsgo --noEmit",
    "lint": "oxlint packages/",
    "lint:fix": "oxlint packages/ --fix",
    "check": "bun run lint && bun run typecheck:fast"
  },
  "devDependencies": {
    "@redwoodjs/agent-ci": "0.7.1",
    "@typescript/native-preview": "7.0.0-dev.20260103.1",
    "oxlint": "1.36.0"
  }
}
