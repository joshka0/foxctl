# foxctl agent-runner sandbox image
#
# This image runs inside k8s agent-sandbox pods. It provides:
# - The sandbox runtime HTTP server (port 8888) for Run/Write/Read API
# - foxctl binary + Go/Python toolchains for agent skill execution
# - git, gh, common CLI tools for repo work
#
# Each agent session gets its own pod from this image via a SandboxWarmPool.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV GOROOT=/usr/local/go
ENV GOPATH=/go
ENV PATH=/usr/local/go/bin:/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# System packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      make \
      openssh-client \
      python3 \
      python3-pip \
      jq \
      ripgrep \
      fd-find \
      && ln -s /usr/bin/fdfind /usr/local/bin/fd \
      && rm -rf /var/lib/apt/lists/*

# Go toolchain
ADD https://go.dev/dl/go1.26.3.linux-amd64.tar.gz /tmp/go.tar.gz
RUN tar -C /usr/local -xzf /tmp/go.tar.gz && rm /tmp/go.tar.gz

# Go tools
RUN go install mvdan.cc/gofumpt@v0.7.0 && \
    go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.8.0

# foxctl binary (built separately and copied in, or built from source)
# For now, we expect it to be COPY'd in during CI build.
# COPY foxctl /usr/local/bin/foxctl

# Repo provisioning script
COPY repo-provision.sh /usr/local/bin/repo-provision
RUN chmod +x /usr/local/bin/repo-provision

# Sandbox runtime HTTP server
COPY sandbox_runtime.py /workspace/sandbox_runtime.py
RUN pip3 install --no-cache-dir --break-system-packages fastapi uvicorn python-multipart

# Workspace setup
RUN mkdir -p /workspace && chmod 777 /workspace
WORKDIR /workspace

EXPOSE 8888

CMD ["python3", "/workspace/sandbox_runtime.py"]
