# Build artifacts
/bin/
/dist/
/coverage/

# Node/Bun
node_modules/
bun.lockb
packages/*/dist/
packages/*/*.tsbuildinfo
configs/opencode-hooks/dist/
web-ui/dist/
web-ui/.vite/

# Go build output
*.test
*.out

.gomodcache/
.gocache/

# SQLite databases (except test fixtures)
*.db
*.db-shm
*.db-wal
!test/**/*.db

# Logs
*.log

# Editor noise
.DS_Store
.idea/
.vscode/

# Environment and secrets
.env
.env.*.local
.env.tmp
*.token
*.key

# Dev binaries in root directory
# Created by running `go build ./cmd/X` or `go build ./skills/X` without -o flag
# Use `make build` or `make skills-install` instead
/agentctl
/agentctl-cgo
/cove_verify

# Skill binaries accidentally built in root (match skill directory names)
# Pattern: any underscore-separated name that matches skills/*/ directories
/build_godot
/ci_*
/code_*
/context_*
/data_*
/editor_*
/embedding_*
/expo
/fs_*
/git_*
/graph
/graph_*
/hooks_*
/html_*
/http_*
/json_*
/lsp_*
/mailbox
/mcp_*
/memory_*
/mobile
/mobile_*
/optimize_*
/opentui
/plan_*
/providers
/session_*
/skill_*
/test_*
/text_*
/todo
/trajectory_*
/verification_*
/wasi_*
/web_*
/x402_*

# Compiled extensions
extensions/*.so
extensions/*.dylib

# Skill binaries - wildcard pattern
# Ignore everything in skill directories except source files
skills/*/*
!skills/*/*.go
!skills/*/*.yaml
!skills/*/*.md
!skills/*/*.json
!skills/*/*.gd
!skills/*/*.wasm
!skills/*/*.cfg
!skills/*/.keep
!skills/*/godot_plugin/
skills/*/godot_plugin/*
!skills/*/godot_plugin/*.gd
!skills/*/godot_plugin/*.cfg
!skills/*/godot_plugin/handlers/
skills/*/godot_plugin/handlers/*
!skills/*/godot_plugin/handlers/*.gd

# Temp files
test_*.go
coderabbit-todos.txt
coderabbit_feedback.txt
pr*.json
pr*.txt

# Claude Code local settings
.claude/settings.local.json.env

# Temp workspace output
/tmp/
/.tmp/

# OpenCode
.opencode/
.fastembed_cache/
.agentctl/

# Compiled test binaries
*_test
!*_test.go
!*_test/
sha256:*
